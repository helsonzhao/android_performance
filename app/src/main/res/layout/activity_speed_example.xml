<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.performance_optimize.speed.SpeedExampleActivity">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cpu_idle_check"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.1 CPU Idle Window Check"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/mmap_io_demo"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.2 Zero-Copy mmap() I/O"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bind_big_core"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.3 Bind Thread to Big Core"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/gc_suppression"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.4 ART GC Suppression"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lfu_cache_demo"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.5 O(1) LFU Cache"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/boost_thread_priority"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.7 Boost UI &amp; RenderThread"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/thread_pool_demo"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="5.8 Monitored Thread Pool"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
