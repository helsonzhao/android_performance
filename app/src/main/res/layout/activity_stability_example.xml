<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stability.StabilityExampleActivity">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/anr"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="7.2 Trigger &amp; Capture ANR"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/oom"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="7.3 Dump &amp; Tailor HPROF"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/crash"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="6.2 Trigger Java Crash"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/native_crash"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="7.1 Trigger Native Crash"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/breakpad"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="7.1 Breakpad Minidump"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/slow_method"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="7.6 Slow Method Monitor"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.coordinatorlayout.widget.CoordinatorLayout>